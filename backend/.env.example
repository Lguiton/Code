# Copy to backend/.env and fill in. NEVER commit .env to git.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=dev

# Required — the app refuses to start without these.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
JWT_SECRET=REPLACE_ME_WITH_64_HEX_CHARS_MIN_32

# AI vision. Leave empty + MOCK_AI=true for offline dev.
GEMINI_API_KEY=
MOCK_AI=true

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:3004

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Rate limiting for the upload + login endpoints.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Table auto-creation. Set to false in production and use migrations.
AUTO_CREATE_TABLES=true

# JWT lifetime for operator sessions (hours).
JWT_EXPIRE_HOURS=12

# Comma-separated allowed Host headers. Set explicitly in production.
ALLOWED_HOSTS=*
